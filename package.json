{
  "name": "dsh-tip-jar",
  "version": "0.1.5",
  "description": "Tip jar for DeepSeek Harness: contributors declare USDC / fiat / subscription / sponsor channels in sponsors.json; a sponsor-center panel, settings page and tool-card credits make them one tap away. 打赏罐——开源贡献者的赞助入口。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "react": "^18.3.1"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/registry.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoxin10086/dsh-tip-jar.git"
  },
  "homepage": "https://github.com/luoxin10086/dsh-tip-jar#readme",
  "bugs": {
    "url": "https://github.com/luoxin10086/dsh-tip-jar/issues"
  }
}
